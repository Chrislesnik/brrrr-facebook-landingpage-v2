# Production/staging environment variables
# Copy or rename this file to ".env" for local defaults (optional),
# or add these in your hosting provider (e.g., Vercel) Environment Variables UI.

VITE_GOOGLE_MAPS_API_KEY=YOUR_PROD_GOOGLE_MAPS_API_KEY

# Number leads can text from the thank-you screen, in +1XXXXXXXXXX format.
# Leave empty to hide the "Text us" button.
VITE_SMS_NUMBER=+15551234567


