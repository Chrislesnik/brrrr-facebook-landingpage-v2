# Local development environment variables
# Copy or rename this file to ".env.local" and fill in your real key.
# After adding/changing env vars, restart the dev server.

VITE_GOOGLE_MAPS_API_KEY=YOUR_DEV_GOOGLE_MAPS_API_KEY

# POST { "inputs": { "<input_code>": value } } and return pricing programs.
# Leave blank until that service exists. The old n8n pricing webhook is not used.
VITE_PRICING_QUOTE_URL=

# After the contact form, POST the scenario and the person's name.
# Returns the application link and the term sheet download link.
# Runs in dev. Leave blank until the save webhook exists.
VITE_PRICING_SAVE_URL=

# Property Data lookup. Leave blank to use the pricing engine webhook.
VITE_PROPERTY_DATA_URL=

# TypeSafe key for the Jev model (jev-latest).
# Server-side only: do not add the VITE_ prefix. The chat dev server reads this
# from .env.local and maps a typed answer onto a choice or a number.
# https://docs.typesafe.ai/api/system-one
JEV_API_KEY=



