# Local development environment variables
# Copy or rename this file to ".env.local" and fill in your real key.
# After adding/changing env vars, restart the dev server.

VITE_GOOGLE_MAPS_API_KEY=YOUR_DEV_GOOGLE_MAPS_API_KEY

# Number leads can text from the thank-you screen, in +1XXXXXXXXXX format.
# Leave empty to hide the "Text us" button.
VITE_SMS_NUMBER=+15551234567


